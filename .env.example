# Qloo hackathon API key (from the Qloo Hackathon Team email).
# Valid ONLY against the hackathon base URL. Server-side only - never in the browser bundle,
# never committed, never printed.
QLOO_API_KEY=

# The hackathon endpoint. The client default is https://api.qloo.com, so this must be set.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# The harness refuses to send credentials to a non-official endpoint unless that exact
# endpoint is trusted. Verified in @qloo/qloo-harness 0.1.26: dist/router.js:5012 builds
# allowCustomBaseUrl from QLOO_TRUSTED_BASE_URL (or `qloo config set base-url`), and
# dist/chunks/chunk-ESNY4EJL.js:462 throws QLOO_CONFIGURATION_ERROR without it.
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Analyst agent (optional). Server-side only; never shipped to the browser. The agent
# is read-only over the committed panel and cannot spend a Qloo request. Any
# OpenAI-compatible endpoint with tool calling works; fallbacks are tried in order.
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
AGENT_LABEL=primary
AGENT_FALLBACK_1_BASE_URL=
AGENT_FALLBACK_1_API_KEY=
AGENT_FALLBACK_1_MODEL=
AGENT_FALLBACK_1_LABEL=fallback 1

# Live Qloo reads for the analyst (off by default; one bounded call per answer).
AGENT_LIVE_QLOO=1
AGENT_LIVE_DAILY_CAP=120

# Server
PORT=8811              # local dev default; the systemd unit on the host sets 8790
AGENT_ASK_PER_HOUR=120 # global cap on analyst answers per hour
AGENT_MIN_GAP_MS=2000  # per-IP gap between answers
